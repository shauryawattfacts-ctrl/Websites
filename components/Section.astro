---
/**
 * Section.astro — one component, many shapes. The `kind` comes from the
 * section model; visual character comes from [data-arch] / tokens, so the same
 * kind looks and behaves differently in each design system.
 */
import Icon from './Icon.astro';
import HeroArt from './HeroArt.astro';
interface Props { biz: any; sec: any; i?: number }
const { biz, sec, i = 0 } = Astro.props;
const anchor = sec.name;
const SECTION_KICKER: Record<string, string> = {
  strip: 'Right now', 'index-list': 'Scope', steps: 'Method', proof: 'Evidence', table: 'Detail',
  map: 'Radius', quotes: 'Public record', editorial: 'In their words', ledger: 'Sources', media: 'In pictures',
  people: 'The bench', menu: 'On offer', cards: 'Notes', faq: 'Answers', intake: 'Contact',
};
const even = i % 2 === 1;
---
<section class={`section s-${sec.kind} ${even ? 'alt' : ''}`} id={anchor} data-sec={sec.kind} aria-labelledby={`${anchor}-h`}>
  <div class="shell">
    {sec.kind !== 'strip' && (
      <header class={`sec-head ${sec.items?.length > 3 ? 'sec-head--row' : ''}`} data-anim="up">
        <div class="stack" style="--stack:.7rem">
          <p class="kicker">{SECTION_KICKER[sec.kind] || sec.title}</p>
          <h2 id={`${anchor}-h`} class="h2">{sec.title}</h2>
          {sec.intro && <p class="lead">{sec.intro}</p>}
        </div>
        {sec.cta && <a class="link" href={sec.cta.href}>{sec.cta.label} <Icon name="arrow" size={15} /></a>}
      </header>
    )}

    {sec.kind === 'strip' && (
      <div class="strip" data-anim="up">
        <p class="cluster" style="gap:.7rem"><Icon name="spark" size={18} /><strong>{sec.lead}</strong></p>
        <ul class="cluster" style="gap:1.6rem;list-style:none;padding:0;margin:0;font-size:.9rem">
          {sec.items.map((it: any) => <li>{it.text}</li>)}
        </ul>
        <a class="btn btn--sm" href={`/${biz.slug}/contact`}>{biz.copy.cta1}</a>
      </div>
    )}

    {sec.kind === 'index-list' && (
      <div class="grid g-side">
        <div class="stack">
          <p class="big-num">{String(sec.items.length).padStart(2, '0')}</p>
          <p class="muted" style="font-size:.9rem">{sec.aside || `${biz.cat} in ${biz.city}`}</p>
          {sec.cta && <p><a class="btn btn--accent" href={sec.cta.href}>{sec.cta.label}</a></p>}
        </div>
        <ol class="list-index" data-stagger>
          {sec.items.map((it: any, n: number) => (
            <li>
              <div class="textlink-row"><h3 class="h4">{it.title}</h3><span class="num">{String(n + 1).padStart(2, '0')}</span></div>
              {it.text && <p class="muted" style="font-size:.94rem;max-width:60ch">{it.text}</p>}
            </li>
          ))}
        </ol>
      </div>
    )}

    {sec.kind === 'steps' && (
      <ol class="steps" data-stagger>
        {sec.items.map((it: any, n: number) => (
          <li>
            <span class="num">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="h4">{it.title}</h3>
            <p class="muted" style="font-size:.95rem">{it.text || ''}</p>
          </li>
        ))}
      </ol>
    )}

    {sec.kind === 'proof' && (
      <div class="stack" style="--stack:2.2rem">
        {sec.stats?.length > 0 && (
          <ul class="proof" data-stagger>
            {sec.stats.map((s: any) => <li style="display:grid;gap:.2rem"><b>{s.value}</b><span class="muted" style="font-size:.86rem">{s.label}</span></li>)}
          </ul>
        )}
        <div class="pillars">
          {sec.items.map((it: any, n: number) => (
            <div><span class="num">{String(n + 1).padStart(2, '0')}</span><p style="font-family:var(--font-display);font-size:var(--step-1);line-height:1.3">{it.text}</p></div>
          ))}
        </div>
        {sec.extra && <p class="note">{sec.extra}</p>}
      </div>
    )}

    {sec.kind === 'table' && (
      <div class="ledger" data-anim="up">
        <table class="data">
          {sec.caption && <caption>{sec.caption}</caption>}
          <tbody>
            {sec.rows.map((r: any) => (
              <tr>{r.cells.map((cell: string, n: number) => (n === 0 ? <th scope="row">{cell}</th> : <td class={/confirm/i.test(cell) ? 'tag' : ''}>{cell}</td>))}</tr>
            ))}
          </tbody>
        </table>
        {sec.note && <p class="note" style="margin-block-start:1rem">{sec.note}</p>}
      </div>
    )}

    {sec.kind === 'map' && (
      <div class="mapbox" data-anim="up">
        <div class="stack">
          <p class="lead">{sec.intro}</p>
          {sec.note && <p class="note">{sec.note}</p>}
        </div>
        <div>
          <ul class="coverage" style="list-style:none;padding:0;margin:0 0 1.2rem">
            <li><strong>{sec.home}</strong><span class="tag">home base</span></li>
            {sec.places.map((p: string) => <li><span>{p}</span><span class="num">in range</span></li>)}
          </ul>
          <svg viewBox="0 0 420 200" role="img" aria-label={`Service map centred on ${sec.home}`}>
            <g class="grid">{Array.from({ length: 9 }, (_, n) => <line x1={n * 52} y1="0" x2={n * 52} y2="200" />).concat(Array.from({ length: 5 }, (_, n) => <line x1="0" y1={n * 50} x2="420" y2={n * 50} />))}</g>
            {sec.places.map((_p: string, n: number) => {
              const a = (n / sec.places.length) * Math.PI * 2;
              return <circle class="ring pulse" cx={210 + Math.cos(a) * (68 + (n % 3) * 26)} cy={100 + Math.sin(a) * (34 + (n % 2) * 22)} r="4" />;
            })}
            <circle class="pin" cx="210" cy="100" r="7" />
            <text x="210" y="82" text-anchor="middle" font-size="11" font-family="var(--font-mono)" fill="currentColor">{sec.home}</text>
          </svg>
        </div>
      </div>
    )}

    {sec.kind === 'quotes' && (
      <div class="stack" style="--stack:1.8rem">
        {sec.stats?.length > 0 && <p class="proof"><b style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.4rem)">{sec.stats[0].value}</b><span class="muted">{sec.stats[0].label}</span></p>}
        <div class="quote-wall" data-stagger>
          {sec.items.map((it: any) => (
            <blockquote class="quote" cite={biz.profiles?.yelp || '#'}>
              <p>“{it.text}”</p>
              <footer class="textlink-row"><span class="num">{it.attribution}</span>{it.draft && <span class="tag">themes, not quotes</span>}</footer>
            </blockquote>
          ))}
        </div>
        <p class="note">This section is deliberately built from review <em>themes</em>: quoted customer text is only published with permission and a link back to the original listing.</p>
      </div>
    )}

    {sec.kind === 'editorial' && (
      <div class="grid g-side">
        <div class="stack">
          {sec.aside?.items?.length > 0 && (
            <div class="card">
              <p class="kicker" style="margin-block-end:.6rem">{sec.aside.title}</p>
              <ul class="stack" style="--stack:.3rem;list-style:none;padding:0;margin:0;font-size:.92rem">
                {sec.aside.items.map((it: any) => <li class="textlink-row"><span>{it.text}</span><span class="num">·</span></li>)}
              </ul>
            </div>
          )}
        </div>
        <div class="prose" data-anim="mask">
          {sec.lede && <p style="font-family:var(--font-display);font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.35">{sec.lede}</p>}
          {sec.body?.map((par: string) => <p>{par}</p>)}
        </div>
      </div>
    )}

    {sec.kind === 'ledger' && (
      <div class="ledger" data-anim="up">
        <table class="data">
          <tbody>{sec.rows.map((r: any) => <tr><th scope="row"><span class="num">01</span> {r.cells[0]}</th><td>{r.cells[1]}</td></tr>)}</tbody>
        </table>
        {sec.note && <p class="note" style="margin-block-start:1rem">{sec.note}</p>}
      </div>
    )}

    {sec.kind === 'media' && (
      <div class="stack" style="--stack:1.4rem">
        <div class="media-grid">
          {sec.items.map((it: any, n: number) => (
            <figure class={`frame ${it.kind === 'tall' ? 'frame--34' : it.kind === 'square' ? 'frame--11' : 'frame--169'}`} data-anim="wipe">
              <HeroArt biz={biz} variant={`m${n}`} />
              <figcaption class="media-cap"><span>{it.title}</span><span class="num">{it.text}</span></figcaption>
            </figure>
          ))}
        </div>
        {sec.note && <p class="note">{sec.note}</p>}
      </div>
    )}

    {sec.kind === 'people' && (
      <div class="stack" style="--stack:1.6rem">
        <div class="grid g3">
          {sec.items.map((it: any) => (
            <article class="card stack" style="--stack:.4rem">
              <span class="tag">{it.role}</span>
              <h3 class="h4">{it.title}</h3>
              <p class="muted" style="font-size:.92rem">{it.text}</p>
            </article>
          ))}
        </div>
        {sec.note && <p class="note">{sec.note}</p>}
      </div>
    )}

    {sec.kind === 'menu' && (
      <ul class="list-index" style="max-width:60ch;margin-inline:auto" data-stagger>
        {sec.items.map((it: any) => (
          <li>
            <div class="textlink-row"><h3 class="h4">{it.title}</h3><span class="num">{it.price}</span></div>
            <p class="muted" style="font-size:.93rem">{it.text}</p>
          </li>
        ))}
      </ul>
    )}

    {sec.kind === 'cards' && (
      <div class="grid card-grid" data-stagger>
        {sec.items.map((it: any) => (
          <article class="card stack" style="--stack:.45rem">
            {it.title && <h3 class="h4">{it.title}</h3>}
            <p style={{ fontSize: it.title ? '.95rem' : 'clamp(1.05rem,1.7vw,1.35rem)', 'line-height': it.title ? '1.55' : '1.35', 'font-family': it.title ? '' : 'var(--font-display)' }}>{it.text}</p>
            {it.draft && <span class="tag">confirm</span>}
          </article>
        ))}
      </div>
    )}

    {sec.kind === 'faq' && (
      <div class="grid g-side">
        <p class="muted" style="font-size:.92rem">Answers below are drafted from public records and the business’s own listing copy. Anything the firm has not confirmed is tagged.</p>
        <div>
          {sec.items.map((it: any, n: number) => (
            <details open={n === 0}>
              <summary>{it.q}</summary>
              <div><p>{it.a}</p>{it.confirm && <p class="cluster" style="margin-block-start:.6rem"><span class="tag">confirm before launch</span></p>}</div>
            </details>
          ))}
        </div>
      </div>
    )}

    {sec.kind === 'intake' && (
      <div class="grid g-side" style="align-items:start">
        <div class="stack">
          <p class="lead">{sec.intro}</p>
          {biz.phone ? (
            <a class="btn" href={`tel:${String(biz.phone).replace(/[^\d+]/g, '')}`}><Icon name="phone" size={16} />{biz.phone}</a>
          ) : (
            <p class="note">No phone line has been supplied for this build, so the enquiry form is the only contact path until the client confirms one.</p>
          )}
          <ul class="stack" style="--stack:.35rem;list-style:none;padding:0;font-size:.92rem">
            <li class="textlink-row"><span>{biz.addr}</span><Icon name="pin" size={15} /></li>
            {biz.hours && <li class="textlink-row"><span>{biz.hours}</span><Icon name="clock" size={15} /></li>}
            {biz.email && <li class="textlink-row"><a class="link" href={`mailto:${biz.email}`}>{biz.email}</a><Icon name="mail" size={15} /></li>}
          </ul>
          {biz.contactNote && <p class="note">{biz.contactNote}</p>}
        </div>
        <form class="card stack intake" style="--stack:1.1rem" data-form novalidate>
          <p class="kicker">Enquiry</p>
          <div class="field"><label for={`n-${i}`}>Your name</label><input id={`n-${i}`} name="name" autocomplete="name" required /></div>
          <div class="intake">
            <div class="field"><label for={`e-${i}`}>Email</label><input id={`e-${i}`} type="email" name="email" autocomplete="email" required /></div>
            <div class="field"><label for={`p-${i}`}>Phone</label><input id={`p-${i}`} type="tel" name="phone" autocomplete="tel" /></div>
          </div>
          <div class="field">
            <label for={`s-${i}`}>What do you need?</label>
            <select id={`s-${i}`} name="service" required>
              <option value="">Choose one…</option>
              {sec.fields.map((f: string) => <option value={f}>{f}</option>)}
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="field"><label for={`m-${i}`}>Message</label><textarea id={`m-${i}`} name="message" placeholder="Address, timing, and what is going on."></textarea></div>
          <p class="cluster" style="justify-content:space-between">
            <button class="btn btn--accent" type="submit">Send enquiry</button>
            <span class="muted" style="font-size:.78rem">Prototype form — connect to the client’s inbox or CRM</span>
          </p>
          <p class="note" data-form-ok hidden>Enquiry captured locally for the demo. On the live site this posts to the client’s endpoint.</p>
        </form>
      </div>
    )}
  </div>
</section>
<style>
  .alt { background: color-mix(in srgb, var(--ink) 2.5%, transparent); }
  .media-cap { display: flex; justify-content: space-between; gap: 1rem; position: absolute; inset-inline: 0; inset-block-end: 0; padding: .8rem 1rem; background: linear-gradient(to top, color-mix(in srgb, var(--ink) 75%, transparent), transparent); color: var(--paper); margin: 0; }
  .frame { position: relative; }
</style>
