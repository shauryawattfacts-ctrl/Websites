---
/**
 * HeroArt.astro — generated SVG artwork per site.
 * A motif is chosen by design system and seeded from the slug, so every
 * business gets its own composition without shipping fifty binary images.
 * Sites that have a produced photograph render that instead (see Hero.astro).
 */
interface Props { biz: any; variant?: string; class?: string }
const { biz, class: cls = '' } = Astro.props;
const t = biz.design.tokens;
const seed = [...biz.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 100000, 7);
const rnd = (n: number, o = 0) => ((seed * (n + 13) + o * 977) % 1000) / 1000;
const motif: Record<string, string> = {
  'home-services': 'waves', 'automotive-garage': 'hazard', 'industrial-brutalist': 'blocks',
  'editorial-legal': 'rules', 'luxe-dark': 'arcs', 'clinical-calm': 'orbs', 'athletic-kinetic': 'bars',
  'hospitality-stay': 'arch', 'appetite-food': 'circles', 'retail-showroom': 'swatch',
  'b2b-spec': 'blueprint', 'civic-heritage': 'seal', 'education-enroll': 'grid', 'studio-portfolio': 'lines',
};
const m = motif[biz.design.system] || 'lines';
const W = 1200, H = 900;
const layers: string[] = [];
const push = (s: string) => layers.push(s);

if (m === 'waves') for (let i = 0; i < 7; i++) push(`<path d="M0 ${180 + i * 96 + rnd(i) * 26} C ${W * .28} ${110 + i * 96} ${W * .62} ${260 + i * 96} ${W} ${150 + i * 96}" fill="none" stroke="${i % 2 ? t.accent : t.ink}" stroke-opacity="${.16 + (i % 3) * .12}" stroke-width="${1 + (i % 3)}"/>`);
if (m === 'hazard') for (let i = 0; i < 26; i++) push(`<rect x="${i * 96 - 300}" y="0" width="34" height="${H}" transform="skewX(-18)" fill="${i % 3 ? t.accent : t.ink}" fill-opacity="${i % 6 ? .12 : .3}"/>`);
if (m === 'blocks') { for (let i = 0; i < 12; i++) { const x = Math.floor(rnd(i, 3) * 6) * 200; const y = Math.floor(rnd(i, 9) * 5) * 180; push(`<rect x="${x}" y="${y}" width="${120 + rnd(i, 2) * 90}" height="${70 + rnd(i, 5) * 80}" fill="${i % 4 ? t.ink : t.accent}" fill-opacity="${i % 4 ? .07 : .22}"/>`); } }
if (m === 'rules') for (let i = 0; i < 15; i++) push(`<rect x="0" y="${40 + i * 60}" width="${300 + rnd(i, 4) * 880}" height="1.5" fill="${i % 5 === 0 ? t.accent : t.ink}" fill-opacity="${i % 5 === 0 ? .5 : .14}"/>`);
if (m === 'arcs') for (let i = 0; i < 6; i++) push(`<circle cx="${W * .5}" cy="${H * .52}" r="${120 + i * 78}" fill="none" stroke="${i === 2 ? t.accent : t.paper}" stroke-opacity="${i === 2 ? .55 : .14}" stroke-width="${i === 2 ? 2 : 1}"/>`);
if (m === 'orbs') for (let i = 0; i < 5; i++) push(`<circle cx="${140 + i * 235}" cy="${300 + rnd(i, 6) * 340}" r="${90 + rnd(i, 3) * 150}" fill="url(#g-${biz.slug})" opacity=".7"/>`);
if (m === 'bars') for (let i = 0; i < 22; i++) push(`<rect x="${i * 56}" y="${H - (120 + rnd(i, 7) * 620)}" width="34" height="${120 + rnd(i, 7) * 620}" fill="${i % 5 === 0 ? t.accent : t.ink}" fill-opacity="${i % 5 === 0 ? .8 : .1}"/>`);
if (m === 'arch') for (let i = 0; i < 5; i++) push(`<path d="M${90 + i * 220} ${H} V${300 + rnd(i, 2) * 120} a${86} ${86} 0 0 1 172 0 V${H}" fill="none" stroke="${i === 1 ? t.accent : t.ink}" stroke-opacity="${i === 1 ? .6 : .18}" stroke-width="2"/>`);
if (m === 'circles') for (let i = 0; i < 9; i++) push(`<circle cx="${80 + (i % 3) * 400 + rnd(i, 1) * 90}" cy="${170 + Math.floor(i / 3) * 260}" r="${60 + rnd(i, 8) * 92}" fill="none" stroke="${i % 3 === 0 ? t.accent : t.ink}" stroke-opacity=".3" stroke-width="${1 + (i % 3)}"/>`);
if (m === 'swatch') { for (let i = 0; i < 6; i++) for (let j = 0; j < 5; j++) push(`<rect x="${60 + i * 185}" y="${60 + j * 165}" width="150" height="130" fill="${(i + j) % 4 === 0 ? t.accent : (i + j) % 4 === 2 ? t.accent2 : t.ink}" fill-opacity="${.06 + rnd(i * 5 + j, 2) * .3}"/>`); }
if (m === 'blueprint') { for (let i = 0; i < 13; i++) push(`<rect x="0" y="${i * 70}" width="${W}" height="1" fill="${t.accent2}" fill-opacity=".2"/>`); for (let i = 0; i < 17; i++) push(`<rect x="${i * 72}" y="0" width="1" height="${H}" fill="${t.accent2}" fill-opacity=".14"/>`); push(`<circle cx="${W * .72}" cy="${H * .3}" r="150" fill="none" stroke="${t.accent}" stroke-width="1.5" stroke-dasharray="8 6" opacity=".7"/>`); }
if (m === 'seal') { push(`<circle cx="${W / 2}" cy="${H / 2}" r="300" fill="none" stroke="${t.accent}" stroke-opacity=".45" stroke-width="1.5"/>`); for (let i = 0; i < 48; i++) { const a = (i / 48) * Math.PI * 2; push(`<line x1="${W / 2 + Math.cos(a) * 288}" y1="${H / 2 + Math.sin(a) * 288}" x2="${W / 2 + Math.cos(a) * 312}" y2="${H / 2 + Math.sin(a) * 312}" stroke="${t.ink}" stroke-opacity=".35"/>`); } }
if (m === 'grid') for (let i = 0; i < 40; i++) push(`<circle cx="${(i % 8) * 160 + 60}" cy="${Math.floor(i / 8) * 172 + 60}" r="${6 + rnd(i, 2) * 26}" fill="${i % 7 === 0 ? t.accent : t.ink}" fill-opacity="${i % 7 === 0 ? .55 : .1}"/>`);
if (m === 'lines') for (let i = 0; i < 18; i++) { const y = i * 52 + 30; push(`<line x1="${rnd(i, 1) * 300}" y1="${y}" x2="${W - rnd(i, 4) * 300}" y2="${y + 130}" stroke="${i % 6 === 0 ? t.accent : t.ink}" stroke-opacity="${i % 6 === 0 ? .5 : .12}" stroke-width="1.4"/>`); }
---
<svg class={cls} viewBox="0 0 {W} {H}" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${biz.name} — ${biz.sub} abstract artwork`}>
  <defs>
    <linearGradient id={`bg-${biz.slug}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={t.paper} />
      <stop offset="1" stop-color={t.invert ? t.ink : t.accent2} stop-opacity=".92" />
    </linearGradient>
    <radialGradient id={`g-${biz.slug}`}>
      <stop offset="0" stop-color={t.accent} stop-opacity=".5" />
      <stop offset="1" stop-color={t.accent2} stop-opacity=".05" />
    </radialGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#bg-${biz.slug})`} />
  <g set:html={layers.join('')} />
</svg>
