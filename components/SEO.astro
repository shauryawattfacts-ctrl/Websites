---
/**
 * SEO.astro — per-page metadata, Open Graph, Twitter cards, canonical,
 * JSON-LD structured data and a hand-built OG image card (SVG, no runtime).
 */

interface Props { title: string; description: string; path: string; biz: any; ogImage?: string; type?: string }
const { title, description, path, biz, type = 'website' } = Astro.props;
const site = (import.meta.env.PUBLIC_SITE_URL || 'https://siliconvalleywebsites.example').replace(/\/$/, '');
const url = `${site}${path}`;
const p = biz.design.tokens;
const ogPng = `${site}/og/${biz.slug}.png`;
const jsonLd = (() => {
  const s = biz.schema || {};
  const node: Record<string, any> = {
    '@context': 'https://schema.org',
    '@type': s.type || 'LocalBusiness',
    name: biz.name,
    description: description,
    url,
    image: ogPng,
    telephone: s.phone || undefined,
    address: { '@type': 'PostalAddress', addressLocality: biz.city, addressRegion: 'CA', postalCode: biz.zip, addressCountry: 'US', streetAddress: s.address?.streetAddress || undefined },
    areaServed: ['San Jose', 'Santa Clara', 'Sunnyvale', 'Milpitas', 'Fremont', 'Mountain View', 'Palo Alto', 'Cupertino', 'Los Altos', 'Los Gatos', 'Saratoga', 'Menlo Park', 'Redwood City'].map((c) => ({ '@type': 'City', name: c })),
    sameAs: s.sameAs?.length ? s.sameAs : undefined,
    slogan: s.slogan,
    aggregateRating: s.rating ? { '@type': 'AggregateRating', ratingValue: s.rating.ratingValue, reviewCount: s.rating.reviewCount, bestRating: 5 } : undefined,
    openingHoursSpecification: s.opening,
    geo: s.geo,
    knowsAbout: biz.services?.slice(0, 6),
  };
  return node;
})();
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: biz.name, item: `/${biz.slug}` }].concat(
    path !== `/${biz.slug}` ? [{ '@type': 'ListItem', position: 2, name: title.split(' — ')[0], item: url }] : []),
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content={p.paper} />
<meta name="color-scheme" content={p.invert ? 'dark' : 'light'} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={biz.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogPng} />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogPng} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
